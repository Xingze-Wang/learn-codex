# Required for every chapter that calls a model (s01-s04, s08, s11, s12, s15).
# Chapters s05, s06, s07, s09, s10, s13, s14 run without it.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.5.
# CODEX_MODEL=gpt-5.5

# Optional. Where s15 writes its sessions and reads hooks/skills.
# Defaults to ~/.learn-codex, so this repo never shows up in your real
# `codex resume` list. Set it to ~/.codex to run against your real install.
# The --show/--list modes of s10, s12 and s14 read ~/.codex directly.
# CODEX_HOME=
